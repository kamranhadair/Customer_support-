# ─── LLM ───────────────────────────────────────────────────────────────────────
GROQ_API_KEY=<paste_your_groq_api_key_here>
GROQ_MODEL=llama-3.3-70b-versatile

# ─── Database ──────────────────────────────────────────────────────────────────
SQLITE_DB_PATH=./data/support.db

# ─── ChromaDB Paths ─────────────────────────────────────────────────────────────
CHROMA_RAG_PATH=./chroma_rag
CHROMA_MEM0_PATH=./chroma_mem0

# ─── Knowledge Base ─────────────────────────────────────────────────────────────
KB_DOCS_PATH=./knowledge_base/docs

# ─── App ────────────────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
BACKEND_URL=http://localhost:8000
